# Datenbank (PostgreSQL)
DATABASE_URL="postgresql://auftragsapp:auftragsapp@localhost:5432/auftragsapp"

# Session
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# S3 / MinIO Objektspeicher
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="auftragsapp"
S3_SECRET_ACCESS_KEY="change-me"
S3_BUCKET="auftragsapp"
S3_FORCE_PATH_STYLE="true"

# Initialer Admin-Account (nur für das Seed-Skript)
SEED_ADMIN_EMAIL="admin@mp-digitalagentur.de"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Admin"
