# Kopiere diese Datei auf dem VPS nach ".env" und trage echte Werte ein.
# Diese Datei wird von docker-compose.yml gelesen.

POSTGRES_USER=auftragsapp
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=auftragsapp

SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

S3_ACCESS_KEY_ID=auftragsapp
S3_SECRET_ACCESS_KEY=change-me-to-a-strong-password
S3_BUCKET=auftragsapp

# Für das Seed-Skript (erster Admin-Account)
SEED_ADMIN_EMAIL=admin@mp-digitalagentur.de
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin
